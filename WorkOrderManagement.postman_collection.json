                    }
                }
            ]
        },
        {
            "name": "Materials",
            "item": [
                {
                    "name": "Get Materials",
                    "request": {
                        "method": "GET",
                        "url": {"raw": "http://localhost:8081/api/materials?page=0&size=20", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api", "materials"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}
                    }
